{
  "name": "autostrada-auctions-front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:ci": "eslint . --max-warnings 0 --format json --output-file test-results/eslint.json",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "test:compose": "node e2e/compose.mjs",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "10.11.0",
    "globals": "16.5.0",
    "jsdom": "^29.1.1",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
