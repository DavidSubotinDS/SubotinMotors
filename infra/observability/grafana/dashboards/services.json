{
  "uid": "autostrada-services",
  "title": "Autostrada — service health",
  "description": "Four application owners and the public gateway. No data is not proof of health. Five-minute rate windows need traffic and multiple scrapes.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "autostrada"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Request throughput",
      "description": "Requests per second, excluding actuator traffic.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "autostrada-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "autostrada:http_requests:rate5m",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "autostrada-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP server error rate",
      "description": "HTTP 5xx divided by all responses. No data for idle services; 4xx are not server failures.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "autostrada-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "autostrada:http_error:ratio5m",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "autostrada-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP p95 latency",
      "description": "95th percentile of server request duration; requires exported histogram buckets.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "autostrada-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "autostrada:http_latency:p95_seconds5m",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "autostrada-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Telemetry endpoint availability",
      "description": "1 means the scrape succeeded, 0 means unreachable. This is not a business readiness check.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "autostrada-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"autostrada\"}",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "autostrada-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Active monitoring alerts",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "autostrada-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\",alertname=~\"Autostrada.*\"}",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "autostrada-prometheus"
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
