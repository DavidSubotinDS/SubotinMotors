# Copy to .env.compose (ignored). Values here are NOT working credentials.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=autostrada
MYSQL_USER=autostrada
# Existing immutable V1-V18 seed demo users, password hashes and catalog data.
# To deliberately initialize that demo baseline set I_ACCEPT_EXISTING_DEMO_DATA.
APP_DEMO_DATA_ACK=
PUBLIC_URL=http://localhost:8081
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8081
SESSION_COOKIE_SECURE=false
STRIPE_ENABLED=false
# Inject sandbox credentials at runtime only if performing separate Stripe smoke.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_MAIL_MODE=log
# Log mode suppresses mail contents/reset links. Use SMTP for actual delivery:
APP_MAIL_FROM=no-reply@autostradaauctions.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
